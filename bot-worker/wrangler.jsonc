
{
  "$schema": "https://schema.cloudflare.com/wrangler/config-schema.json",
  "name": "miniapps-telegram-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_MEMORY",
      "id": "e68d281224e44a8291eb33e0f782b927"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
